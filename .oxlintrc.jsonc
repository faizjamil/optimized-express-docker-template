    //       "**/vue.config.js",
    //       "**/webpack.config.js",
    //       "**/webpack.config.*.js",
    //       "**/rollup.config.js",
    //       "**/rollup.config.*.js",
    //       "**/gulpfile.js",
    //       "**/gulpfile.*.js",
    //       "**/Gruntfile{,.js}",
    //       "**/protractor.conf.js",
    //       "**/protractor.conf.*.js",
    //       "**/karma.conf.js",
    //       "**/.eslintrc.js"
